# Copy this file to .env and uncomment any values you want to override.
# All settings have sensible defaults in config.py — only set what you need.

# ── Dense retrieval ───────────────────────────────────────────────────────────
# DENSE_MODEL=nomic-ai/nomic-embed-text-v1.5
# DENSE_EMBED_DIM=768
# DENSE_BATCH_SIZE=64

# ── Chunking ──────────────────────────────────────────────────────────────────
# Token limit per chunk (approx chars // 4). Below the 8,192-token context
# window to leave headroom for the "search_document: " task prefix.
# CHUNK_TOKEN_LIMIT=7000

# ── BM25 parameters ───────────────────────────────────────────────────────────
# BM25_K1=1.5
# BM25_B=0.75

# ── Rank Fusion ───────────────────────────────────────────────────────────────
# RRF_K=60
# TOP_K_RETRIEVAL=20
# TOP_K_FUSED=5
# RRF_DENSE_WEIGHT=1.0
# RRF_SPARSE_WEIGHT=1.0

# ── LLM generation (Ollama) ───────────────────────────────────────────────────
# LLM_MODEL=llama3.3:70b
# LLM_MAX_TOKENS=2048
# LLM_OLLAMA_BASE_URL=http://localhost:11434/v1

# ── File paths ────────────────────────────────────────────────────────────────
# CORPUS_PATH=data/corpus/eu_climate_articles.jsonl
# INDEX_DIR=data/indices
# GOLD_STANDARD_PATH=data/evaluation/gold_standard.json
