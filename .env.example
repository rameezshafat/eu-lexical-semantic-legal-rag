# Copy this file to .env and fill in your keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional overrides (defaults shown)
# Dense embedding model (sentence-transformers / BGE-M3)
DENSE_MODEL=BAAI/bge-m3
DENSE_EMBED_DIM=1024
DENSE_BATCH_SIZE=64

BM25_K1=1.5
BM25_B=0.75

RRF_K=60
TOP_K_RETRIEVAL=20
TOP_K_FUSED=5

LLM_MODEL=llama3.3:70b
LLM_MAX_TOKENS=2048

CORPUS_PATH=data/corpus/eu_climate_articles.jsonl
INDEX_DIR=data/indices
GOLD_STANDARD_PATH=data/evaluation/gold_standard.json
